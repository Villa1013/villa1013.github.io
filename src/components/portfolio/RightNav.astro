---
interface Props {
  langPrefix?: string;
  isDetailPage?: boolean;
}

const { langPrefix = "", isDetailPage = false } = Astro.props;
---

<!-- right-nav -->
<ul class="right-nav nav-scroll">
    <li>
        <a class={isDetailPage ? "" : "scroll-to active"} href={isDetailPage ? langPrefix + "/" : "#home"}>
            <i class="icon icon-home-solid"></i>
            <span class="tooltip text-body-3" data-i18n="nav.home">Home</span>
        </a>
    </li>
    <li>
        <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#works" : "#works"}>
            <i class="icon icon-tasks-solid"></i>
            <span class="tooltip text-body-3" data-i18n="nav.works_short">Works</span>
        </a>
    </li>
    <li>
        <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#services" : "#services"}>
            <i class="icon icon-stream-solid"></i>
            <span class="tooltip text-body-3" data-i18n="nav.services">Services</span>
        </a>
    </li>
    <li>
        <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#about" : "#about"}>
            <i class="icon icon-user-solid"></i>
            <span class="tooltip text-body-3" data-i18n="nav.about">About</span>
        </a>
    </li>
    <!-- <li>
        <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#testimonial" : "#testimonial"}>
            <i class="icon icon-poll-h-solid"></i>
            <span class="tooltip text-body-3" data-i18n="nav.testimonial">Testimonial</span>
        </a>
    </li> -->
    <!-- <li>
        <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#pricing" : "#pricing"}>
            <i class="icon icon-tags-solid"></i>
            <span class="tooltip text-body-3" data-i18n="nav.pricing">Pricing</span>
        </a>
    </li> -->
    <li>
        <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#contact" : "#contact"}>
            <i class="icon icon-envelope-solid"></i>
            <span class="tooltip text-body-3" data-i18n="nav.contact">Contact</span>
        </a>
    </li>
</ul>
<!-- /right-nav -->
