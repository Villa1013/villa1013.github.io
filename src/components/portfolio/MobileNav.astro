---
interface Props {
  langPrefix?: string;
  isDetailPage?: boolean;
}

const { langPrefix = "", isDetailPage = false } = Astro.props;
---

<!-- tf-btn-menu -->
<div class="tf-btn-menu">
   <img src="/asset/icons/dashboard.svg" alt="">
</div>
<!-- /tf-btn-menu -->

<!-- tf-sidebar-menu -->
<div class="tf-sidebar-menu tf-canvas">
    <div class="overlay"></div>
    <div class="sidebar-menu-inner">
        <div class="sidebar-wrap">
            <div class="sidebar-heading">
                <div class="heading text-body-1 dot-before" data-i18n="nav.menu">Menu</div>
                <span class="close-canvas">
                    <i class="icon icon-times-solid"></i>
                </span>
            </div>
            <ul class="sidebar-nav nav-scroll">
                <li>
                    <a class={isDetailPage ? "" : "scroll-to active"} href={isDetailPage ? langPrefix + "/" : "#home"}>
                        <i class="icon icon-home-solid"></i><span class="text-body-2" data-i18n="nav.home">Home</span>
                    </a>
                </li>
                <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#experience" : "#experience"}>
                        <i class="icon icon-toolbox-solid"></i><span class="text-body-2" data-i18n="nav.experience">Experience</span>
                    </a>
                </li>
                <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#works" : "#works"}>
                        <i class="icon icon-tasks-solid"></i><span class="text-body-2" data-i18n="nav.works">Selected Works</span>
                    </a>
                </li>
                <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#services" : "#services"}>
                        <i class="icon icon-stream-solid"></i><span class="text-body-2" data-i18n="nav.services">Services</span>
                    </a>
                </li>
                <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#about" : "#about"}>
                        <i class="icon icon-user-solid"></i><span class="text-body-2" data-i18n="nav.about">About</span>
                    </a>
                </li>
                <!-- <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#testimonial" : "#testimonial"}>
                        <i class="icon icon-poll-h-solid"></i><span class="text-body-2" data-i18n="nav.testimonial">Testimonial</span>
                    </a>
                </li> -->
                <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#partners" : "#partners"}>
                        <i class="icon icon-user-friends-solid"></i><span class="text-body-2" data-i18n="nav.partners">Partners</span>
                    </a>
                </li>
                <!-- <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#pricing" : "#pricing"}>
                        <i class="icon icon-tags-solid"></i><span class="text-body-2" data-i18n="nav.pricing">Pricing</span>
                    </a>
                </li> -->
                <li>
                    <a class={isDetailPage ? "" : "scroll-to"} href={isDetailPage ? langPrefix + "/#contact" : "#contact"}>
                        <i class="icon icon-envelope-solid"></i><span class="text-body-2" data-i18n="nav.contact">Contact</span>
                    </a>
                </li>
            </ul>
        </div>
        <div class="sidebar-social">
            <div class="heading text-body-1 dot-before" data-i18n="nav.social">Social Network</div>
            <ul class="social-links">
                <li>
                    <a href="https://www.linkedin.com/in/williamvillalba/" target="_blank"><i class="icon icon-linkedin-in"></i></a>
                </li>
                <li>
                    <a href="https://github.com/villa1013" target="_blank"><i class="icon icon-github"></i></a>
                </li>
                <li>
                    <a href="https://www.behance.net/williamvillalba" target="_blank"><i class="icon icon-behance"></i></a>
                </li>
                <li>
                    <a href="https://x.com/villa10crack" target="_blank"><i class="icon icon-twitter-x"></i></a>
                </li>
            </ul>
        </div>
    </div>
</div>
<!-- /tf-sidebar-menu -->
