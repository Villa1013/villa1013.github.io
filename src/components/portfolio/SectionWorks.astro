---
import { projects } from "../../data/projects";

const pathname = Astro.url.pathname.replace(/\/+$/, "");
const lang: "en" | "es" = pathname.startsWith("/es") || pathname.indexOf("/es/") !== -1 ? "es" : "en";
---

<!-- section-selected-works -->
<section class="section-selected-works" id="works">
    <div class="tf-container">
        <div class="row">
            <div class="offset-xxl-5 col-xxl-7 offset-xl-4 col-xl-7 offset-lg-2 col-lg-8">
                <div class="banner-slider">
                    <div class="text-container scroll-banners effect-right">
                        <span class="banner-text text-display-2 fw-medium">Selected Work</span>
                        <span class="banner-img"><span class="dot-circle"></span></span>
                        <span class="banner-text text-display-2 fw-medium">Selected Work</span>
                        <span class="banner-img"><span class="dot-circle"></span></span>
                        <span class="banner-text text-display-2 fw-medium">Selected Work</span>
                        <span class="banner-img"><span class="dot-circle"></span></span>
                        <span class="banner-text text-display-2 fw-medium">Selected Work</span>
                        <span class="banner-img"><span class="dot-circle"></span></span>
                        <span class="banner-text text-display-2 fw-medium">Selected Work</span>
                        <span class="banner-img"><span class="dot-circle"></span></span>
                        <span class="banner-text text-display-2 fw-medium">Selected Work</span>
                        <span class="banner-img"><span class="dot-circle"></span></span>
                    </div>
                </div>
                <div class="works-wrap">
                    {projects.map((project) => {
                        const t = project[lang];
                        const workHref = `/work/${project.slug}/`;
                        return (
                            <div class="works-item scrolling-effect effectLeft">
                                <a class="image" href={workHref}>
                                    <img class="lazyload" src={project.image} data-src={project.image} alt={`${t.name} - ${t.category}`} />
                                </a>
                                <div class="content">
                                    <div class="infor">
                                        <div class="sub-heading sub">{t.category}</div>
                                        <h3 class="title">
                                            <a href={workHref}>{t.name}</a>
                                        </h3>
                                    </div>
                                    <a href={workHref} class="btn-links">
                                        <i class="icon icon-arrow-top-right"></i>
                                    </a>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </div>
    </div>
</section>
<div class="box-gradient1 img_bg-1"></div>
<!-- /section-selected-works -->
