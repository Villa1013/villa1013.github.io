---
import { techStack } from "../../data/techstack";
---

<!-- section-tech-stack -->
<section class="section-tech-stack">
    <div class="tf-container">
        <div class="row">
            <div class="offset-xxl-5 col-xxl-7 offset-xl-4 col-xl-7 offset-lg-2 col-lg-8">
                <div class="text-display-2 fw-medium heading split-text effect-right">Tech Stack</div>
                <div class="swiper slider-tech-stack">
                    <div class="swiper-wrapper">
                        {techStack.map((category, index) => (
                            <div class="swiper-slide">
                                <div class="tech-stack-card">
                                    <div class="tech-stack-card-header">
                                        <span class="tech-stack-card-subtitle">0{index + 1}</span>
                                        <h3 class="tech-stack-card-title">{category.en.title}</h3>
                                    </div>
                                    <div class="tech-stack-card-items">
                                        {category.items.map((item) => (
                                            <span class="tech-stack-card-item">{item}</span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                    <div class="swiper-pagination pagination-tech-stack"></div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /section-tech-stack -->
